#include <stdio.h>

//memoisasi
void rekur(int n, int a, int b, int c){
    int f[n];
    f[1] = a;
    f[2] = b;
    f[3] = c;
    
    for(int i = 4; i <= n; i++){
        f[i] = f[i - 1] + f[i - 2] + f[i - 3];
    }
    printf("%d", f[n]);
}

int main(){
    int n, a, b, c;
    scanf("%d %d %d %d", &n, &a, &b, &c);
    
    rekur(n, a, b, c);
    return 0;
}
