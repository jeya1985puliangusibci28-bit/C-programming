#include <stdio.h>
#include <string.h>
#include <math.h>
#include <stdlib.h>

int main() 
{

    int n;
    scanf("%d", &n);
      // Complete the code to print the pattern.
    
    for(int i = 0; i < n+(n-1); i++){
        for(int j = 0; j < n+(n-1); j++){
            if(i + j <= 2*n-2){ //if on superior diagonal
                int min = i < j? i : j; //Store the lesser value
                printf("%d ", n-min);
            }
            else{
                int max = i > j? i : j; //Store the greater value
                printf("%d ",max - n + 2);
            }
        }
        printf("\n");
    }
    return 0;
}
