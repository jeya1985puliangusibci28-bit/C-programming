int main() {
    int total_number_of_shelves;
    if (scanf("%d", &total_number_of_shelves) != 1) return 1;
    
    int total_number_of_queries;
    if (scanf("%d", &total_number_of_queries) != 1) return 1;

    // Allocate memory for tracking books per shelf (initialized to 0)
    int* total_number_of_books = (int*)calloc(total_number_of_shelves, sizeof(int));
    
    // Allocate memory for the 2D dynamic array (rows point to dynamically resized page counts)
    int** total_number_of_pages = (int**)malloc(total_number_of_shelves * sizeof(int*));
    for (int i = 0; i < total_number_of_shelves; i++) {
        total_number_of_pages[i] = NULL;
    }

    while (total_number_of_queries--) {
        int type_of_query;
        if (scanf("%d", &type_of_query) != 1) break;
        
        if (type_of_query == 1) {
            int x, y;
            if (scanf("%d %d", &x, &y) != 2) break;
            
            // Determine the new number of books on shelf x
            int current_books = total_number_of_books[x];
            int new_books = current_books + 1;
            
            // Resize the page array for shelf x to accommodate the new book
            int* temp = (int*)realloc(total_number_of_pages[x], new_books * sizeof(int));
            if (temp == NULL) {
                return 1; // Out of memory
            }
            total_number_of_pages[x] = temp;
            
            // Insert the book's page count at the end of the shelf
            total_number_of_pages[x][current_books] = y;
            
            // Update the book count for shelf x
            total_number_of_books[x] = new_books;
            
        } else if (type_of_query == 2) {
            int x, y;
            if (scanf("%d %d", &x, &y) != 2) break;
            printf("%d\n", total_number_of_pages[x][y]);
        } else if (type_of_query == 3) {
            int x;
            if (scanf("%d", &x) != 1) break;
            printf("%d\n", total_number_of_books[x]);
        }
    }

    // Clean up allocated memory
    if (total_number_of_books) {
        free(total_number_of_books);
    }
    for (int i = 0; i < total_number_of_shelves; i++) {
        if (total_number_of_pages[i]) {
            free(total_number_of_pages[i]);
        }
    }
    if (total_number_of_pages) {
        free(total_number_of_pages);
    }
    
    return 0;
