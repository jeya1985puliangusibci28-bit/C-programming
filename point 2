

#include <stdio.h>
#include <stdlib.h>

void update(int *a, int *b) {
    int temp_a = *a;
    int temp_b = *b;

    *a = temp_a + temp_b;
    *b = abs(temp_a - temp_b);
}

int main() {
    int x = 5;
    int y = 3;
    
    update(&x, &y);
    
    printf("x = %d, y = %d\n", x, y); // Outputs: x = 8, y = 2
    return 0;
}
